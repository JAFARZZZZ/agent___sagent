SELLER_TOKEN=replace-with-a-long-random-secret
CATALOG_DATABASE=data/processed/catalog.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional compatible Responses endpoint; defaults to official OpenAI.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_TOOL_ROUNDS=5
OPENAI_MAX_OUTPUT_TOKENS=1500
SELLER_DEMO_SECRET=

# --- Hybrid search: vector index (see README "جستجوی ترکیبی") ---
# openai = any OpenAI-compatible embeddings API (OpenAI / AvalAI), uses OPENAI_API_KEY/OPENAI_BASE_URL unless overridden
# local  = sentence-transformers on this machine (pip install sentence-transformers), e.g. BAAI/bge-m3
# hashing = offline character n-gram vectors (no model, typo-tolerant, not semantic)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Seconds before the demo seller auto-reply arrives (simulated calls)
SELLER_AUTO_REPLY_SECONDS=6
# Vision model used to look at product photos (defaults to OPENAI_MODEL; must accept images, e.g. gpt-4o-mini / gpt-4o)
OPENAI_VISION_MODEL=
